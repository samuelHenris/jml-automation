<mxfile host="app.diagrams.net"><diagram name="Decision flow" id="decision-flow"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="start" value="&lt;b&gt;For each employee in HR&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="15" width="180" height="45" as="geometry"/></mxCell><mxCell id="q1" value="&lt;b&gt;Account exists&lt;/b&gt;&lt;br&gt;in directory?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="545" y="100" width="190" height="90" as="geometry"/></mxCell><mxCell id="q2" value="&lt;b&gt;Active in HR?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="195" y="255" width="190" height="90" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;Do nothing&lt;/b&gt;&lt;br&gt;never create for&lt;br&gt;people already gone" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="10" y="265" width="150" height="70" as="geometry"/></mxCell><mxCell id="joiner" value="&lt;b&gt;JOINER&lt;/b&gt;&lt;br&gt;create account&lt;br&gt;+ policy groups" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="195" y="420" width="190" height="70" as="geometry"/></mxCell><mxCell id="q3" value="&lt;b&gt;Active in HR?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="545" y="255" width="190" height="90" as="geometry"/></mxCell><mxCell id="q4" value="&lt;b&gt;Account enabled?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="905" y="255" width="190" height="90" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Do nothing&lt;/b&gt;&lt;br&gt;already disabled" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1130" y="265" width="170" height="70" as="geometry"/></mxCell><mxCell id="leaver" value="&lt;b&gt;LEAVER&lt;/b&gt;&lt;br&gt;remove all groups, disable" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="905" y="390" width="190" height="60" as="geometry"/></mxCell><mxCell id="q5" value="&lt;b&gt;Account disabled?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="545" y="410" width="190" height="90" as="geometry"/></mxCell><mxCell id="rehire" value="&lt;b&gt;REHIRE&lt;/b&gt;&lt;br&gt;re-enable + fix groups" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="470" width="200" height="60" as="geometry"/></mxCell><mxCell id="q6" value="&lt;b&gt;Department or&lt;/b&gt;&lt;br&gt;title changed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="545" y="565" width="190" height="90" as="geometry"/></mxCell><mxCell id="mover" value="&lt;b&gt;MOVER&lt;/b&gt;&lt;br&gt;add new groups&lt;br&gt;remove old groups" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="575" width="200" height="70" as="geometry"/></mxCell><mxCell id="q7" value="&lt;b&gt;Groups or attributes&lt;/b&gt;&lt;br&gt;differ from policy?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="545" y="720" width="190" height="90" as="geometry"/></mxCell><mxCell id="sync" value="&lt;b&gt;SYNC&lt;/b&gt;&lt;br&gt;correct the drift" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D0F0EE;strokeColor=#3A9E98;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="730" width="200" height="70" as="geometry"/></mxCell><mxCell id="nochange" value="&lt;b&gt;No change&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="565" y="860" width="150" height="50" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Active means:&lt;/b&gt;&lt;br&gt;not terminated, OR terminated with&lt;br&gt;an end date still in the future" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="540" width="360" height="90" as="geometry"/></mxCell><mxCell id="orphan" value="&lt;b&gt;After the loop: ORPHAN&lt;/b&gt;&lt;br&gt;enabled accounts with no HR record&lt;br&gt;are flagged for a human,&lt;br&gt;never changed automatically" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="660" width="360" height="100" as="geometry"/></mxCell><mxCell id="lbl0" value="Per-employee decision logic (diff.py)" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="500" height="20" as="geometry"/></mxCell><mxCell id="lbl1" value="no" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="405.0" y="123" width="30" height="20" as="geometry"/></mxCell><mxCell id="lbl2" value="yes